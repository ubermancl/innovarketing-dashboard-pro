# ===========================================
# Innovarketing Dashboard Pro — Variables de entorno
# ===========================================
# Copiar a .env y completar. El servidor NO arranca sin JWT_SECRET y DASHBOARD_PASSWORD.

# --- Servidor ---

# URL de la API de NocoDB (tabla de leads)
NOCODB_API_URL=https://tu-nocodb.com/api/v2/tables/TU_TABLE_ID/records

# Token xc-token de NocoDB
NOCODB_API_TOKEN=

# Contraseña para acceder al dashboard (sin default — obligatoria)
DASHBOARD_PASSWORD=

# Secreto JWT — mínimo 32 caracteres aleatorios (sin default — obligatorio)
# Generar con: openssl rand -base64 32
JWT_SECRET=

# Puerto del servidor (default: 3000)
PORT=3000

# --- Frontend ---

# URL base de la API — no cambiar en producción con Docker
VITE_API_URL=/api
